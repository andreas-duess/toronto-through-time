{
  "name": "toronto-through-time",
  "compatibility_date": "2026-11-10",
  "main": "worker.js",
  // static files are served without running the Worker; only these paths go through it
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/photos/*"] },
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "toronto-through-time-photos" }],
  // the main address and its www form; toronto.duess.com, the first address, is sent on by ../redirect
  "routes": [
    { "pattern": "torontothroughtime.com", "custom_domain": true },
    { "pattern": "www.torontothroughtime.com", "custom_domain": true }
  ]
}
